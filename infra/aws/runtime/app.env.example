NODE_ENV=production
PORT=3000
APP_URL=https://celizlk.store
SITE_URL=https://celizlk.store
NEXT_PUBLIC_SITE_URL=https://celizlk.store
CORS_ALLOWED_ORIGINS=https://celizlk.store
