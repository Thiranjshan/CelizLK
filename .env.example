# Copy to .env.local for local development. Never commit real values.
DATABASE_URL="postgresql://celiz_dev:celiz_dev@localhost:5432/celizdb?schema=public"
JWT_ACCESS_SECRET="replace-with-a-random-secret-at-least-32-characters"
ADMIN_JWT_SECRET="replace-with-a-different-random-secret-at-least-32-characters"
DELIVERY_FEE_LKR="350"
NEXT_PUBLIC_DELIVERY_FEE_LKR="350"

# Only set this when intentionally resetting a disposable local database.
# ALLOW_DESTRUCTIVE_SEED="true"